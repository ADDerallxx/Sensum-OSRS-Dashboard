{
  "policy": "sensum.structural-member-candidate-identity-review-decision-import-policy.v1",
  "queueContract": "sensum.structural-member-candidate-identity-review-queue-entry.v1",
  "submissionContract": "sensum.structural-member-candidate-identity-review-decision-template.v1",
  "recordContract": "sensum.structural-member-candidate-identity-review-decision.v1",
  "auditContract": "sensum.structural-member-candidate-identity-review-decision-import-audit.v1",
  "queueState": "pending_explicit_source_bound_candidate_identity_review",
  "recordState": "recorded_source_bound_candidate_identity_review_decision_pending_semantic_disposition",
  "allowedDecisions": [
    "confirm_source_page_subject_identity_for_candidate",
    "reject_source_page_subject_identity_for_candidate",
    "needs_additional_evidence"
  ],
  "rules": {
    "oneRecordedDecisionPerCompletedSubmission": true,
    "partialReviewBatchesAreAllowed": true,
    "blankTemplateRowsAreIgnored": true,
    "partiallyCompletedRowsAreRejected": true,
    "anyInvalidRowRejectsTheEntireBatch": true,
    "queueRecordManifestEntryAndContentHashesMustRevalidate": true,
    "submissionMustMatchQueuePacketAndEvidenceBindings": true,
    "decisionMustBeExplicitlyAllowed": true,
    "reviewerReviewedAtSourceRevisionsAndNotesAreRequired": true,
    "reviewedAtMustNotPrecedePinnedEvidenceTimestamps": true,
    "decisionSourceRevisionsMustExactlyMatchTheQueueEvidenceScope": true,
    "obviousAutomaticOrModelReviewerNamesAreRejected": true,
    "recordingADecisionDoesNotApplyAnIdentityMembershipRepeatabilityMechanicsMappingCompletenessOrOptimizerVerdict": true,
    "namesTitlesPageIdsRevisionsCandidateKeysLabelsAliasesAndOverridesCannotAlterPolicyBehavior": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
