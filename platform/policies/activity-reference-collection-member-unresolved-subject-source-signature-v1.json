  "rules": {
    "policyContainsNoPageIdsTitlesCandidateKeysCollectionClassesOrOverrides": true,
    "oneRecordPerRoutedUnresolvedSubject": true,
    "inputIdentityRevisionHashesCollectionRowMembershipAndAliasContextMustBePreserved": true,
    "onlyExactRetainedRevisionContentMayEnterThePacket": true,
    "allRootTemplatesDirectCategoriesLeadParagraphsHeadingsAndSourceAuthoredLinksRemainEvidenceOnly": true,
    "allDirectWikilinkOccurrencesMustBePreservedInSourceOrder": true,
    "collectionDisplayLabelMembershipAndAliasesCannotSupplySubjectIdentityOrAlterEvidence": true,
    "linkedTargetsAreRelationshipCandidatesNotCanonicalRelationships": true,
    "unresolvedSubjectStateRemainsBlocked": true,
    "canonicalIdentityRepeatabilityMembersMechanicsAndOptimizerEligibilityRemainClosed": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
