    "bindingClass": "revision_pinned_title_aligned_activity_infobox_name_subject",
    "verdict": "source_supported_canonical_activity_subject_declaration"
  },
  "rules": {
    "oneDispositionPerCompleteSchemaEvidencePacket": true,
    "subjectBindingRequiresTheCompleteStructuralAndSchemaEvidenceChain": true,
    "subjectBindingRequiresExactlyOneQualifiedCandidatePage": true,
    "subjectBindingRequiresEveryStructuralCheckAndSchemaObservation": true,
    "candidatePageIdentityRevisionTitleAndOccurrenceMustRemainAligned": true,
    "schemaEvidenceMeaningIsAppliedOnlyToTheExactQualifiedInfoboxOccurrence": true,
