  "blockerRules": [
    { "pattern": "^(?:tightrope_1|zip_line)_success_probability_at_base_level_34_not_published$", "domain": "target_success_probability", "diagnosticKinds": ["target_numeric_probability", "success_chart_parameters"], "requiredEvidenceShape": "A source-bound numeric success probability at base level 34, or obstacle-specific low/high parameters usable with the pinned Wiki interpolation formula." },
    { "pattern": "^(?:aggregate_)?failure_probability_at_base_level_34_not_published$", "domain": "target_success_probability", "diagnosticKinds": ["target_numeric_probability", "success_chart_parameters"], "requiredEvidenceShape": "A source-bound numeric failure probability at base level 34, or complete obstacle-specific parameters from which it can be calculated." },
    { "pattern": "^success_interpolation_low_high_parameters_not_published$", "domain": "success_interpolation_parameters", "diagnosticKinds": ["success_chart_parameters"], "requiredEvidenceShape": "Obstacle-specific low and high integer parameters explicitly bound to the pinned Wiki skilling-success interpolation formula." },
    { "pattern": "^failed_obstacle_xp_outcome_not_published$", "domain": "failed_attempt_xp", "diagnosticKinds": ["failed_attempt_xp"], "requiredEvidenceShape": "A source statement identifying XP awarded on each failed attempt for the exact obstacle or route variant." },
    { "pattern": "^failure_recovery_route_and_time_penalty_not_published$", "domain": "failure_recovery", "diagnosticKinds": ["failure_recovery"], "requiredEvidenceShape": "A source statement identifying post-failure position or recovery route and its tick/second penalty." },
    { "pattern": "^observed_rate_scope_20_to_30_does_not_cover_base_level_34$", "domain": "target_expected_rate", "diagnosticKinds": ["exact_target_rate"], "requiredEvidenceShape": "An expected or observed rate explicitly scoped to base level 34 and the same route conditions." },
    { "pattern": "^observed_rate_level_scope_does_not_identify_base_level_34$", "domain": "target_expected_rate", "diagnosticKinds": ["exact_target_rate"], "requiredEvidenceShape": "An observed rate whose published level scope explicitly includes base level 34 and whose other conditions match." },
    { "pattern": "^expected_xp_per_hour_at_base_level_34_not_published$", "domain": "target_expected_rate", "diagnosticKinds": ["exact_target_rate"], "requiredEvidenceShape": "A condition-matched expected XP/hour value at base level 34, or complete mechanics sufficient to calculate it." },
    { "pattern": "^observed_xp_per_hour_at_base_level_34_equipment_state_not_published$", "domain": "equipment_scoped_rate", "diagnosticKinds": ["detached_rate_equipment_scope"], "requiredEvidenceShape": "The exact equipment and diary state attached to the detached floor-spike observed rate." },
    { "pattern": "^failure_capable_obstacle_identity_not_published$", "domain": "failure_capable_identity", "diagnosticKinds": ["shayzien_failure_capable_identity"], "requiredEvidenceShape": "An explicit source statement identifying which non-tightrope Shayzien Basic obstacle types can fail." },
    { "pattern": "^supporting_rate_matches_superseded_pre_update_value$", "domain": "rate_revision_alignment", "diagnosticKinds": ["shayzien_rate_alignment"], "requiredEvidenceShape": "Revision-aligned source text that reconciles the overview's average rate with the post-update course rate without treating an upper bound as expected performance." }
  ],
