  "rules": {
    "oneRoutePerRepeatabilityDisposition": true,
    "everyEmittableDispositionStateMustHaveExactlyOneRoute": true,
    "supportedRepeatableRoutesToMemberAndMechanicsEvidence": true,
    "supportedNonRepeatableRoutesToExclusionScopeReviewNotAutomaticExclusion": true,
    "conflictingUnresolvedAndIncompleteStatesRemainBlocked": true,
    "recurrenceAndSessionStructureCannotBePromotedToRepeatability": true,
    "absenceOfEvidenceCannotBePromotedToNonRepeatability": true,
    "routesDescribeEvidenceObligationsNotGameFacts": true,
    "namesTitlesPageIdsCandidateKeysLabelsAliasesAndCollectionClassesCannotSelectOrAlterRoutes": true,
    "inputEvidenceIdentityRevisionHashesAndContextMustBePreserved": true,
    "routingCannotChangeRepeatabilityDispositionOrReview": true,
    "routingCannotCompleteMemberExpansionOrMechanics": true,
    "routingCannotCreateOptimizerCandidates": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
