{
  "policy": "sensum.agility-colossal-wyrm-termite-reward-rate-dry-run-refresh-orchestration-policy.v1",
  "mode": "isolated_local_dry_run",
  "runDirectoryName": "agility-colossal-wyrm-termite-reward-rate-refresh-runs",
  "inputContracts": {
    "fieldAudit": "sensum.agility-colossal-wyrm-obsolete-notice-field-reconciliation-audit.v1",
    "fieldManifest": "sensum.ingestion-manifest.v1",
    "baselineRegistryAudit": "sensum.agility-colossal-wyrm-termite-reward-rate-source-change-monitoring-registry-audit.v1",
    "baselineRegistryManifest": "sensum.ingestion-manifest.v1"
  },
  "stages": [
    {
      "stageKey": "reward_source_discovery",
      "script": "platform/ingestion/ingest-wiki-agility-colossal-wyrm-termite-reward-rate-source-discovery.mjs",
      "reportContract": "sensum.agility-colossal-wyrm-termite-reward-rate-source-discovery-audit.v1",
      "outputDomain": "agility-colossal-wyrm-termite-reward-rate-source-discovery",
      "dependencies": ["field_reconciliation"]
    },
    {
      "stageKey": "reward_source_sufficiency",
      "script": "platform/transforms/materialize-agility-colossal-wyrm-termite-reward-rate-source-sufficiency-disposition.mjs",
      "reportContract": "sensum.agility-colossal-wyrm-termite-reward-rate-source-sufficiency-disposition-audit.v1",
      "outputDomain": "agility-colossal-wyrm-termite-reward-rate-source-sufficiency-disposition",
      "dependencies": ["reward_source_discovery"]
    },
    {
      "stageKey": "reward_source_change_registry",
      "script": "platform/transforms/materialize-agility-colossal-wyrm-termite-reward-rate-source-change-monitoring-registry.mjs",
      "reportContract": "sensum.agility-colossal-wyrm-termite-reward-rate-source-change-monitoring-registry-audit.v1",
      "outputDomain": "agility-colossal-wyrm-termite-reward-rate-source-change-monitoring-registry",
      "dependencies": ["reward_source_discovery", "reward_source_sufficiency"]
    },
    {
      "stageKey": "reward_source_change_evaluation",
      "script": "platform/transforms/evaluate-agility-colossal-wyrm-termite-reward-rate-source-changes.mjs",
      "reportContract": "sensum.agility-colossal-wyrm-termite-reward-rate-source-change-evaluation-audit.v1",
      "outputDomain": "agility-colossal-wyrm-termite-reward-rate-source-change-evaluation",
      "dependencies": ["baseline_registry", "reward_source_change_registry"]
    }
  ],
  "recordContract": "sensum.agility-colossal-wyrm-termite-reward-rate-dry-run-refresh-lineage.v1",
  "auditContract": "sensum.agility-colossal-wyrm-termite-reward-rate-dry-run-refresh-orchestration-audit.v1",
  "outputDomain": "agility-colossal-wyrm-termite-reward-rate-dry-run-refresh-orchestration",
  "rules": {
    "allFourExternalInputsMustBeExplicitlySelected": true,
    "fieldAndBaselineRegistryInputsMustValidateBeforeExecution": true,
    "allStagesRunSequentiallyInsideOneIsolatedLocalDirectory": true,
    "eachStageMustExitZeroAndPublishAValidReportAndSnapshotBeforeTheNextStarts": true,
    "everyStageReportManifestRawPayloadPolicyAuditAndContentHashMustValidate": true,
    "everyDownstreamDependencyMustBindTheExactPriorReportAndSnapshotHashes": true,
    "firstFailureStopsAllRemainingStagesAndProducesNoSuccessfulLineageSnapshot": true,
    "successfulLineageMustContainExactlyFourOrderedStages": true,
    "refreshDoesNotApproveEvidenceApplySemanticsOrCloseBlockers": true,
    "changeEvaluationEventsOnlyRequeueExactEvidenceWork": true,
    "noSchedulerCloudResourceProductionDataMigrationDeploymentOrCutoverIsAllowed": true,
    "deployClaspMigrationAndProductionCommandsAreForbidden": true,
    "optimizerEligibilityAndVerifiedBestAreForbidden": true,
    "accountSpecificInputsAreForbidden": true,
    "completeWikiOrActivityUniverseClaimsAreForbidden": true,
    "automaticVerificationAllowed": false
  }
}
