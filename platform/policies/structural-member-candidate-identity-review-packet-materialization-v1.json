{
  "policy": "sensum.structural-member-candidate-identity-review-packet-materialization-policy.v1",
  "inputContract": "sensum.structural-member-candidate-review-ready-identity-and-remaining-gap-work-routing.v1",
  "recordContract": "sensum.structural-member-candidate-identity-review-packets.v1",
  "auditContract": "sensum.structural-member-candidate-identity-review-packet-materialization-audit.v1",
  "inputState": "structural_member_candidate_review_ready_identity_and_remaining_gap_work_routed_gates_closed",
  "reviewRouteKey": "source_bound_candidate_identity_review",
  "allowedDecisions": ["confirm_source_page_subject_identity_for_candidate", "reject_source_page_subject_identity_for_candidate", "needs_additional_evidence"],
  "rules": {
    "onePacketPerReviewReadyIdentityWorkItem": true,
    "exactRevisionSubjectSourceIdentityHashBytesAndTextMustRevalidate": true,
    "oneIdentityBearingRootInfoboxMustMatchTheReadinessEvidence": true,
    "sourceAuthoredNameFieldsMustMatchTheExactInfobox": true,
    "candidateDispositionMustMatchTheRoutedCandidateExactly": true,
    "parentOccurrenceRevisionHashLocatorAndExactTextMustRevalidate": true,
    "reviewPacketMustContainSubjectAndParentEvidence": true,
    "packetGenerationDoesNotRecordAReviewDecision": true,
    "confirmedSourcePageSubjectIdentityWouldNotProveParentMembership": true,
    "identityReviewCannotProveWeightRepeatabilityMechanicsMappingOrCompleteness": true,
    "allReviewDecisionsVerdictsAndCanonicalIdentitiesRemainNull": true,
    "allNonReviewRoutesAndUpstreamEvidenceMustBePreserved": true,
    "namesTitlesPageIdsRevisionsCandidateKeysLabelsAliasesAndOverridesCannotAlterPolicyBehavior": true,
    "memberExpansionMechanicsAndOptimizerPromotionAreForbidden": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
