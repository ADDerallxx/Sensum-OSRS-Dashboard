{
  "policy": "sensum.activity-reference-collection-member-source-evidence-policy.v1",
  "inputContract": "sensum.activity-reference-collection-member-candidate.v1",
  "recordContract": "sensum.activity-reference-collection-member-source-evidence.v1",
  "auditContract": "sensum.activity-reference-collection-member-source-evidence-audit.v1",
  "structuralAndLexicalEvidencePolicy": "sensum.activity-candidate-semantic-evidence-policy.v1",
  "evidenceScope": [
    "exact_member_source_content_at_retained_observed_wiki_revision",
    "balanced_infobox_activity_or_infobox_minigame_invocation_when_present",
    "complete_source_heading_inventory",
    "lead_paragraph_review_evidence",
    "source_line_lexical_review_candidates"
  ],
  "rules": {
    "oneRecordPerExplicitCollectionMemberCandidate": true,
    "inputCollectionRowMembershipAndAliasContextMustBePreserved": true,
    "allMemberLinkIdentityOccurrencesWithinOneCandidateMustResolveToOneRevisionPinnedWikiPage": true,
    "fetchedPageIdTitleRevisionTimestampAndContentHashMustMatchTheRetainedMemberIdentity": true,
    "onlyExactRetainedRevisionContentMayEnterThePacket": true,
    "infoboxParametersRemainRawSourceEvidence": true,
    "headingsAndLeadParagraphsRemainReviewEvidenceNotCompletenessClaims": true,
    "lexicalMatchesAreReviewCandidatesNotParsedFacts": true,
    "collectionMembershipAndMemberSourceEvidenceCannotEstablishCanonicalIdentity": true,
    "repeatabilityRequiresSeparateSemanticReview": true,
    "requirementsVariantsXpTimingAndMechanicsRequireSeparateStructuredEvidence": true,
    "noCandidateIsOptimizerEligibleAtThisStage": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
