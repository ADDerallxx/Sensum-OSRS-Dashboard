{
  "policy": "sensum.activity-canonical-subject-scope-evidence-work-routing-policy.v1",
  "inputContract": "sensum.activity-infobox-schema-semantics-disposition.v1",
  "recordContract": "sensum.activity-canonical-subject-scope-evidence-work-routing.v1",
  "auditContract": "sensum.activity-canonical-subject-scope-evidence-work-routing-audit.v1",
  "eligibleInputState": "canonical_activity_subject_declaration_source_supported_scope_and_repeatability_unresolved",
  "route": {
    "routeKey": "collect_revision_pinned_canonical_activity_scope_evidence",
    "routeState": "blocked_canonical_activity_scope_evidence_gap",
    "requiredEvidenceDomains": [
      "canonical_subject_page_exact_revision",
      "lead_and_infobox_activity_description",
      "declared_activity_purpose_and_skill_relationship",
      "activity_boundary_and_composite_member_relationships",
      "scope_exclusions_and_condition_boundaries",
      "separate_repeatability_evidence_obligation"
    ]
  },
  "rules": {
    "oneRoutePerSourceSupportedCanonicalActivitySubjectBinding": true,
    "everyEligibleBindingMustBeRoutedExactlyOnce": true,
    "onlySourceSupportedCanonicalActivitySubjectBindingsAreEligible": true,
    "routeSelectionUsesOnlyTheAuditedSubjectBindingState": true,
    "routeDescribesEvidenceObligationsNotGameFacts": true,
    "activityOrMinigamePageTypeDoesNotEstablishActivityScope": true,
    "subjectBindingDoesNotEstablishTrainingScopeRepeatabilityOrMembership": true,
    "scopeAndRepeatabilityRemainSeparateEvidenceGates": true,
    "namesTitlesPageIdsCandidateKeysLabelsAliasesCollectionClassesAndOverridesCannotSelectOrAlterTheRoute": true,
    "inputEvidenceIdentityRevisionHashesBindingDispositionAndContextMustBePreserved": true,
    "routingCannotAlterSubjectBindingsOrSubjectDeclarationVerdicts": true,
    "routingCannotClassifyActivityScopeOrRepeatability": true,
    "routingCannotCompleteMemberExpansionOrMechanics": true,
    "routingCannotCreateOptimizerCandidates": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
