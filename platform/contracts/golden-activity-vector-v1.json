{
  "contract": "sensum.golden-activity-vector.v1",
  "required": {
    "identity": ["familyKey", "recordKey", "name", "sourceRevision"],
    "conditions": ["skill", "entryLevel", "modeledMinimumLevel"],
    "mechanics": ["cycle", "xpPerSuccess", "failureModel"],
    "calculation": ["formulaVersion", "calculationKind", "point estimate or bounded range"],
    "validation": ["rateValidation", "contradictions", "sourceLocators"]
  },
  "states": ["blocked", "proposed", "approved", "rejected", "stale"],
  "candidateIdentityPolicy": {
    "benchmarkSeriesRequireStableCandidateGroupKey": true,
    "distinctConditionPoliciesCannotShareAGroupKey": true,
    "ungroupedVectorsRemainIndependentCandidates": true
  },
  "timingPolicy": {
    "boundedCycleRangesCannotBecomePointEstimates": true,
    "boundedCycleRangesProduceOrderedRateRanges": true,
    "timeDependentRewardsCrossingABoundRequireSeparateModeling": true,
    "intervalOnlyRatesCannotEnterScalarRanking": true,
    "intervalComparisonRequiresStrictlyNonOverlappingBounds": true,
    "touchingOrOverlappingIntervalsRemainIncomparable": true,
    "observedPeakTimingCannotBecomeTypicalTiming": true,
    "timeBasedCompletionOutcomesMayOmitRandomFailureRoll": true,
    "unknownRandomFailureStateRemainsNull": true
  },
  "approvalPolicy": {
    "automaticApprovalAllowed": false,
    "allMechanicalFactsMustBeVerified": true,
    "conditionsMustBeExplicit": true,
    "pointEstimateMustMatchObservedRangeWithinTolerance": true,
    "boundedRateRequiresSourceTimingAndRewardReview": true,
    "contradictionsBlockApproval": true,
    "sourceRevisionChangeMarksStale": true,
    "approvedVectorMayOpenOnlyItsOwnScenario": true
  }
}
