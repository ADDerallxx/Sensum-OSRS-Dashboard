{
  "contract": "sensum.activity-canonical-subject-scope-disposition.v1",
  "required": [
    "memberCandidateKey",
    "sourceActivityCanonicalSubjectScopeEvidenceContentHash",
    "canonicalActivityIdentity",
    "canonicalActivitySubjectBinding",
    "canonicalActivityScopeEvidence",
    "canonicalActivityScopeEvidenceSources",
    "canonicalActivityScopeDisposition",
    "canonicalActivityScopeReview",
    "memberExpansionReview",
    "mechanicsReview",
    "optimizerEligible",
    "accountIndependent",
    "blockers",
    "state"
  ],
  "rules": {
