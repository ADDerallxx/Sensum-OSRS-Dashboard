{
  "contract": "sensum.activity-reference-collection-member-unresolved-subject-signature-disposition.v1",
  "required": [
    "memberCandidateKey",
    "sourceSignatureContentHash",
    "sourceRoutingContentHash",
    "sourceMemberDispositionContentHash",
    "sourceMemberEvidenceContentHash",
    "collectionContext",
    "memberIdentityContexts",
    "sourcePageId",
    "resolvedTitle",
    "membershipClassification",
    "sourceRevision",
    "sourceTimestamp",
    "sourceUrl",
    "sourceContentHash",
    "sourceSignatureEvidenceSummary",
    "dispositionSignals",
    "sourcePageSubjectDisposition",
    "collectionActivityIdentityReview",
    "linkedSubjectRelationshipReview",
    "canonicalGameEntityIdentity",
    "canonicalActivityIdentity",
    "repeatabilityReview",
    "memberExpansionReview",
    "mechanicsReview",
    "optimizerEligible",
    "accountIndependent",
    "blockers"
  ],
  "rules": {
    "oneRecordPerExactRevisionUnresolvedSubjectSignature": true,
    "inputHashesIdentityRevisionCollectionMembershipAndAliasContextMustBePreserved": true,
    "everyDispositionSignalMustReferenceAnExactMappedRootTemplate": true,
    "allMappedRootTemplateSignalsForASourcePageMustAgree": true,
    "unmappedAndConflictingSignalsRemainExplicit": true,
    "collectionContextAndLinkedPagesCannotSupplyOrAlterSourcePageSubjectDisposition": true,
    "sourcePageSubjectClassDoesNotEstablishCollectionActivityIdentityOrRelationship": true,
    "activityPageTypeDoesNotProveRepeatability": true,
    "canonicalIdentityMembersMechanicsAndOptimizerPromotionAreForbidden": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
