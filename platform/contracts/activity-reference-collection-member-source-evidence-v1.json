{
  "contract": "sensum.activity-reference-collection-member-source-evidence.v1",
  "required": [
    "memberCandidateKey",
    "sourceMemberCandidateContentHash",
    "collectionContext",
    "memberIdentityContexts",
    "sourcePageId",
    "resolvedTitle",
    "sourceRevision",
    "sourceTimestamp",
    "sourceUrl",
    "sourceContentHash",
    "sourceContentBytes",
    "revisionAlignment",
    "membershipClassification",
    "infoboxEvidence",
    "leadParagraphEvidence",
    "headingEvidence",
    "lexicalReviewCandidates",
    "semanticIdentityReview",
    "repeatabilityReview",
    "canonicalGameEntityIdentity",
    "canonicalActivityIdentity",
    "optimizerEligible",
    "accountIndependent",
    "blockers"
  ],
  "rules": {
    "oneRecordPerInputCollectionMemberCandidate": true,
    "inputCandidateContentHashAndAllCollectionContextMustBePreserved": true,
    "aliasOccurrencesRemainDistinctWhileSharingOneStableWikiIdentity": true,
    "fetchedContentUsesTheRetainedExactMemberRevision": true,
    "sourceHashReconcilesWithTheRetainedMemberIdentity": true,
    "balancedSupportedInfoboxFieldsPreserveRawWikitextAndLocations": true,
    "allSourceHeadingsAndLeadParagraphsArePreservedInOrder": true,
    "lexicalMatchesAreReviewCandidatesOnly": true,
    "missingSupportedInfoboxIsMeasuredButDoesNotInventAType": true,
    "semanticIdentityAndRepeatabilityRemainUnreviewed": true,
    "canonicalIdentityAndOptimizerPromotionAreForbidden": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
