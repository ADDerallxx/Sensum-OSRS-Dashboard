    "sourceCanonicalActivitySubjectDeclarationSemanticEvidenceWorkRoutingContentHash",
    "canonicalActivityIdentity",
    "canonicalActivitySubjectDeclarationStructuralDisposition",
    "canonicalActivitySubjectBinding",
    "canonicalActivitySubjectDeclarationReview",
    "schemaEvidenceSources",
    "activityInfoboxSchemaSemanticsEvidence",
    "activityInfoboxSchemaSemanticsReview",
    "memberExpansionReview",
    "mechanicsReview",
    "optimizerEligible",
    "accountIndependent",
    "blockers",
