{
  "contract": "sensum.accepted-evidence-postgresql-materialization-audit.v1",
  "required": [
    "registryContract",
    "domain",
    "input",
    "database",
    "before",
    "reconciled",
    "expected",
    "hashes",
    "gates",
    "transactionRollbackProven",
    "idempotentReapplicationProven",
    "productionMutations",
    "optimizerPromotions",
    "verifiedBestAuthorizations",
    "publishable",
    "contentHash"
  ],
  "rules": {
    "onlyRegisteredDomainAdaptersMayMaterialize": true,
    "onlyAuditAcceptedRevisionPinnedSnapshotsMayMaterialize": true,
    "snapshotAndAuditHashesMustReconcileBeforeDatabaseAccess": true,
    "losslessRawRecordsMustBeRetained": true,
    "candidateEvidenceMustRemainCandidateAndOptimizerIneligible": true,
    "semanticReviewRequirementsMustRemainVisible": true,
    "anyValidationOrDatabaseMismatchRollsBackTheWholeTransaction": true,
    "reapplicationMustBeIdempotent": true,
    "automaticVerificationAllowed": false,
    "productionMutationAllowed": false
  }
}
