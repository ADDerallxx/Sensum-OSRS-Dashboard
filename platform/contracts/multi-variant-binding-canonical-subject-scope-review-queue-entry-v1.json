{
  "contract": "sensum.multi-variant-binding-canonical-subject-scope-review-queue-entry.v1",
  "required": [
    "queueEntryKey",
    "queueOrdinal",
    "sourceDispositionKey",
    "sourceDispositionRecordContentHash",
    "sourceDispositionSnapshotContentHash",
    "sourceEvidencePacketKey",
    "sourceEvidencePacketRecordContentHash",
    "sourceEvidencePacketSnapshotContentHash",
    "evidenceFingerprint",
    "structuralCandidateKey",
    "candidateRole",
    "candidateDisplayName",
    "canonicalSubjectContextEvidenceState",
    "exactNumberedVariantAlignmentEvidenceState",
    "evidenceSourceIdentities",
    "candidateScopedParentContextObservations",
    "numberedVariantIdentityObservations",
    "exactTaskToNumberedVariantAlignmentObservations",
    "reviewScope",
    "allowedDecisions",
    "decisionTemplate",
    "reviewDecision",
    "reviewCandidateVariantIndex",
    "bindingReviewDecision",
    "boundVariantIndex",
    "candidateMemberIdentityVerdict",
    "parentMembershipVerdict",
    "weightedTaskEntryMembershipVerdict",
    "repeatabilityVerdict",
    "mechanicsReviewComplete",
    "mappingVerdict",
    "inventoryCompletenessVerdict",
    "memberUniverseComplete",
    "optimizerEligible",
    "automaticVerificationApplied",
    "accountIndependent",
    "blockers",
    "state",
    "recordContentHash"
  ],
  "rules": {
    "entryBindsOneEligibleDispositionAndItsExactSourcePacket": true,
    "canonicalContextAndNumberedIdentityObservationsRemainDistinct": true,
    "canonicalContextRowsRetainExactMatchedLinesAndFullSectionHashes": true,
    "exactTaskToNumberedVariantAlignmentMustRemainAbsent": true,
    "reviewAndBindingFieldsStartNull": true,
    "allSemanticAndOptimizerGatesRemainClosed": true,
    "recordIsAccountIndependent": true
  }
}
