    "queueOrdinal",
    "sourceDispositionKey",
    "sourceDispositionRecordContentHash",
    "sourceEvidenceRecordContentHash",
    "sourceDispositionSnapshotContentHash",
    "sourceEvidenceSnapshotContentHash",
    "evidenceFingerprint",
    "renderedTargetKey",
    "requestedTitles",
    "resolutionEvidence",
    "allowedDecisions",
    "decisionTemplate",
    "canonicalGameEntityIdentity",
    "canonicalActivityIdentity",
    "repeatabilityClassification",
    "optimizerEligible",
    "accountIndependent",
    "state"
