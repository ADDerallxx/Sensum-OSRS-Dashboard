{
  "contract": "sensum.unlock-linked-page-entity-type.v1",
  "required": ["targetKey", "requestedTitle", "resolvedTitle", "entityTypes", "entityTypeEvidence", "classificationState", "canonicalEntityIdentity", "repeatabilityEvidence", "optimizerEligible", "source", "accountIndependent", "blockers"],
  "rules": {
    "everySourceSignatureMustReceiveExactlyOneClassificationRecord": true,
    "everyTypeRequiresAnExactPolicyMappedRootTemplate": true,
    "everyEvidenceLocatorRetainsRevisionHashAndSourceLine": true,
    "untypedAndMultiTypedPagesRemainExplicit": true,
    "typedPageIsNotACanonicalEntityOrActivity": true,
    "activityPageCandidateIsNotRepeatabilityProof": true,
    "noRecordIsOptimizerEligibleAtThisStage": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
