{
  "contract": "sensum.unlock-linked-page-entity-type.v2",
  "supersedes": "sensum.unlock-linked-page-entity-type.v1",
  "required": ["targetKey", "requestedTitle", "requestedFragment", "redirected", "referencedBy", "resolvedTitle", "entityTypes", "entityTypeEvidence", "classificationState", "canonicalEntityIdentity", "repeatabilityEvidence", "optimizerEligible", "source", "accountIndependent", "blockers"],
  "rules": {
    "everySourceSignatureMustReceiveExactlyOneClassificationRecord": true,
    "everyTypeRequiresAnExactPolicyMappedSourceSignal": true,
    "rootTemplateEvidenceTakesPriority": true,
    "directCategoryEvidenceIsFallbackOnly": true,
    "everyEvidenceLocatorRetainsPageIdRevisionHashAndSourceLine": true,
    "stableWikiPageIdAndEveryOriginalReferenceContextArePreserved": true,
    "untypedAndMultiTypedPagesRemainExplicit": true,
    "typedPageIsNotACanonicalEntityOrActivity": true,
    "activityPageCandidateIsNotRepeatabilityProof": true,
    "noRecordIsOptimizerEligibleAtThisStage": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
