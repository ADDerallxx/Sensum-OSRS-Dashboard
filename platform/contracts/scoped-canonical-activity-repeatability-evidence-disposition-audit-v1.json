{
  "contract": "sensum.scoped-canonical-activity-repeatability-evidence-disposition-audit.v1",
  "required": [
    "inputCoverage",
    "policyCoverage",
    "signalDispositionCoverage",
    "domainDispositionCoverage",
    "semanticPreservationCoverage",
    "accountStateFindings",
    "dispositionAttemptCoverageComplete",
    "repeatabilityClassificationCoverageComplete",
    "repeatabilityReviewComplete",
    "completeActivityUniverse",
    "absoluteBestGate",
    "blockers",
    "publishable"
  ],
  "rules": {
    "inputOutputSetsHashesEvidenceAndContextMustMatchExactly": true,
    "everyInputSignalMustHaveExactlyOnePolicyDerivedRole": true,
    "everyEvidenceDomainMustHaveAnExplicitDisposition": true,
    "structuralEligibilityAndReferenceSignalsCannotBecomeRepeatabilityProof": true,
    "zeroSignalsCannotBecomeNegativeEvidence": true,
    "repeatabilityVerdictsAndDownstreamPromotionsAreForbidden": true,
    "currentAccountStateIsForbidden": true
  }
}
