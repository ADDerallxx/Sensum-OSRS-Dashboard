{
  "contract": "sensum.multi-variant-binding-review-decision.v1",
  "required": [
    "decisionKey",
    "queueEntryKey",
    "sourceDispositionKey",
    "sourceQueueSnapshotContentHash",
    "sourceQueueRecordContentHash",
    "sourceQueueEntryContentHash",
    "sourceEvidencePacketContentHash",
    "evidenceFingerprint",
    "structuralCandidateKey",
    "candidateRole",
    "reviewCandidateVariantIndex",
    "decision",
    "reviewer",
    "reviewedAt",
    "decisionSourceRevisions",
    "reviewNotes",
    "reviewDecisionRecorded",
    "semanticDispositionApplied",
    "bindingReviewDecision",
    "boundVariantIndex",
    "candidateMemberIdentityVerdict",
    "parentMembershipVerdict",
    "weightedTaskEntryMembershipVerdict",
    "repeatabilityVerdict",
    "mechanicsReviewComplete",
    "mappingVerdict",
    "inventoryCompletenessVerdict",
    "memberUniverseComplete",
    "optimizerEligible",
    "automaticVerificationApplied",
    "accountIndependent",
    "state"
  ],
  "rules": {
    "decisionIsBoundToTheExactQueueDispositionPacketEvidenceFingerprintAndReviewCandidateIndex": true,
    "reviewerTimestampSourceRevisionsAndNotesAreExplicit": true,
    "reviewTimestampCannotPrecedeThePinnedEvidence": true,
    "decisionRecordingIsSeparateFromSemanticDisposition": true,
    "reviewCandidateVariantIndexRemainsUnbound": true,
    "allBindingIdentityMembershipRepeatabilityMechanicsMappingCompletenessAndOptimizerVerdictsRemainClosed": true,
    "recordIsAccountIndependent": true
  }
}
