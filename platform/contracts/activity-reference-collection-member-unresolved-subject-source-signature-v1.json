{
  "contract": "sensum.activity-reference-collection-member-unresolved-subject-source-signature.v1",
  "required": [
    "memberCandidateKey",
    "sourceRoutingContentHash",
    "sourceMemberDispositionContentHash",
    "sourceMemberEvidenceContentHash",
    "collectionContext",
    "memberIdentityContexts",
    "sourcePageId",
    "resolvedTitle",
    "membershipClassification",
    "sourceRevision",
    "sourceTimestamp",
    "sourceUrl",
    "sourceContentHash",
    "sourceContentBytes",
    "revisionAlignment",
    "rootTemplates",
    "rootTemplateDelimiterAudit",
    "directCategories",
    "leadParagraphEvidence",
    "headingEvidence",
    "sourceAuthoredLinks",
    "sourceLinkDelimiterAudit",
    "subjectIdentityReview",
    "linkedSubjectRelationshipReview",
    "canonicalGameEntityIdentity",
    "canonicalActivityIdentity",
    "repeatabilityReview",
    "memberExpansionReview",
    "optimizerEligible",
    "accountIndependent",
    "blockers"
  ],
  "rules": {
    "oneRecordPerRoutedUnresolvedSubject": true,
    "inputRoutingHashesIdentityCollectionAndAliasContextMustBePreserved": true,
    "fetchedContentMustMatchInputPageIdTitleRevisionTimestampAndContentHash": true,
    "rootTemplatesAndDirectCategoriesAreStructuralSignalsOnly": true,
    "leadParagraphsAndHeadingsAreSourceDeclarationEvidenceOnly": true,
    "directWikilinksAreLinkedSubjectRelationshipCandidatesOnly": true,
    "sourceLinkAndTemplateDelimiterImbalanceBlocksPublication": true,
    "collectionDisplayLabelMembershipAndAliasesCannotCreateOrChangeSourceEvidence": true,
    "subjectIdentityAndLinkedRelationshipsRemainUnreviewed": true,
    "canonicalIdentityRepeatabilityMemberExpansionMechanicsAndOptimizerPromotionAreForbidden": true,
    "currentAccountStateIsForbidden": true,
    "automaticVerificationAllowed": false
  }
}
