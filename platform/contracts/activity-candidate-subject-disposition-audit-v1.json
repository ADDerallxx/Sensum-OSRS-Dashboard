{
  "contract": "sensum.activity-candidate-subject-disposition-audit.v1",
  "required": [
    "inputCoverage",
    "policyCoverage",
    "dispositionCoverage",
    "semanticPromotionCoverage",
    "dispositionAttemptCoverageComplete",
    "subjectDispositionComplete",
    "completeActivityUniverse",
    "absoluteBestGate",
    "blockers"
  ],
  "rules": {
    "inputAndOutputCandidateSetsMustMatchExactly": true,
