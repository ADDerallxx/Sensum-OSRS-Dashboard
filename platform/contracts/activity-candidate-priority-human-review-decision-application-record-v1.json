{
  "contract": "sensum.activity-candidate-priority-human-review-decision-application-record.v1",
  "required": [
    "applicationKey",
    "decisionKey",
    "reviewPacketKey",
    "candidateKey",
    "sourcePacketSnapshotContentHash",
    "sourceDecisionSnapshotContentHash",
    "sourcePacketRecordContentHash",
    "sourcePacketOuterContentHash",
    "sourceDecisionRecordContentHash",
    "sourceDecisionOuterContentHash",
    "applicationPolicyContentHash",
    "sourcePageIdentity",
    "pipelineBindings",
    "reviewer",
    "reviewedAt",
    "reviewNotes",
    "reviewEvidenceKeys",
    "reviewedSourceRevisions",
    "subjectDispositionDecision",
    "appliedSubjectDisposition",
    "canonicalGameEntityIdentityDecision",
    "canonicalGameEntityIdentity",
    "canonicalActivityIdentityDecision",
    "canonicalActivityIdentity",
    "repeatabilityDecision",
    "repeatabilityClassification",
    "atomicityDecision",
    "atomicityClassification",
    "memberExpansionDisposition",
    "memberExpansionRequired",
    "memberKeys",
    "memberExpansionApplied",
    "memberUniverseComplete",
    "evidenceDomainReviewAssessments",
    "additionalEvidenceDomains",
    "unsupportedEvidenceDomains",
    "sourceConflictPresent",
    "sourceConflictResolved",
    "candidateSemanticReviewComplete",
    "authoritativeExclusionApplied",
    "applicationOutcome",
    "semanticReviewApplicationApplied",
    "requirementsVariantsXpTimingAndMechanicsComplete",
    "completeActivityUniverse",
    "optimizerEligible",
    "automaticVerificationApplied",
    "accountIndependent",
    "blockers",
    "state",
    "recordContentHash"
