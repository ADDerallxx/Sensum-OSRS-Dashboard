{
  "contract": "sensum.agility-obstacle-training-variant.v1",
  "required": [
    "parent_name",
    "variant_key",
    "name",
    "entry_level",
    "xp_per_success",
    "failure_free_level",
    "source_revision",
    "source_locator"
  ],
  "rules": {
    "tableRequirementAndTrainingClaimMustMatchOneObstacle": true,
    "tableEntryLevelMustRemainSeparateFromObservedRateLevel": true,
    "exactOrUpperBoundObservedRateIsRequired": true,
    "sourceUpperBoundsMustRemainNonExpectedEvidence": true,
    "missingRoundTripTimingMustRemainExplicit": true,
    "missingOrAmbiguousObstacleMatchBlocksPublication": true,
    "automaticVerificationAllowed": false
  }
}
