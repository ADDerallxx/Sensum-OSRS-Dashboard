    "candidateRole",
    "candidateDisplayName",
    "decision",
    "reviewer",
    "reviewedAt",
    "decisionSourceRevisions",
    "reviewNotes",
    "reviewDecisionRecorded",
    "semanticDispositionApplied",
    "canonicalSubjectScopeReviewDecision",
