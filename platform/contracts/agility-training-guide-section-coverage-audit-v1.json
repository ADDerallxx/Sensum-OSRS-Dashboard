{
  "contract": "sensum.agility-training-guide-section-coverage-audit.v1",
  "required": [
    "sourceRevision",
    "headingCount",
    "materialSectionCount",
    "coveredSectionCount",
    "uncoveredSectionCount",
    "sectionDetails",
    "blockers"
  ],
  "rules": {
    "everyMaterialSectionRequiresCandidateParserCoverage": true,
    "multipleCandidatesMayBelongToOneSourceSection": true,
    "orphanCandidatesBlockCoverage": true,
    "collectionAndCompositeInternalsRequireSeparateAudit": true,
    "completedMemberAuditsMustMatchTheSameGuideRevision": true,
    "officialGuideIsNotAssumedToBeExhaustive": true,
    "uncoveredSectionsRemainNamedAndSourceLocated": true,
    "automaticVerificationAllowed": false
  }
}
