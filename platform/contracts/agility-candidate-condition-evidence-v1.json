{
  "contract": "sensum.agility-candidate-condition-evidence.v1",
  "required": [
    "candidate_key",
    "method_variant",
    "entry_level",
    "failure_possible",
    "failure_outcomes",
    "source_revision",
    "source_locator"
  ],
  "rules": {
    "sourceStatementMayEstablishThatFailureIsPossible": true,
    "failureProbabilityMustNotBeInferredFromFailurePossibility": true,
    "perObstacleDamageRangeIsNotAFailureProbability": true,
    "automaticVerificationAllowed": false
  }
}
