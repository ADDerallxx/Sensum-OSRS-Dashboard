{
  "contract": "sensum.golden-review-packet.v1",
  "checklist": ["identity", "conditions", "performance evidence", "source locators", "formula or explicit observation", "calculation or observation shape", "unit agreement", "rate validation", "contradictions", "scope"],
  "decisions": ["approve", "reject", "needs_evidence"],
  "rules": {
    "generationDoesNotApprove": true,
    "reviewerIdentityRequiredForDecision": true,
    "decisionMustMatchSourceRevision": true,
    "unresolvedContradictionBlocksApproval": true,
    "missingMechanicalFactBlocksApproval": true,
    "sourceDerivedBoundedRateMayBeReviewedWithoutIndependentObservedRate": true,
    "sourceObservedRateMayBeReviewedWithoutSyntheticMechanics": true,
    "boundedReviewDoesNotAuthorizeScalarRanking": true,
    "approvalScopeIsExactScenario": true
  }
}
