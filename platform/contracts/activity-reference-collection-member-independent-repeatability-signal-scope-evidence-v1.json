    "canonicalActivityIdentity",
    "repeatabilityDisposition",
    "repeatabilityReview",
    "corroboratingRepeatabilityDisposition",
    "corroboratingRepeatabilityReview",
    "independentRepeatabilitySourceEvidence",
    "independentRepeatabilityCandidateObservations",
    "independentRepeatabilitySignalScopeEvidence",
    "independentRepeatabilitySignalScopeObservations",
    "memberExpansionReview",
    "mechanicsReview",
    "optimizerEligible",
    "accountIndependent",
    "blockers"
